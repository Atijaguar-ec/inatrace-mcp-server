# INATrace MCP Server Environment Configuration Template

# Server Configuration
SERVER_NAME=inatrace-oracle
PORT=8000
DEBUG=false

# PostgreSQL Database (Read-Only User inatrace_mcp_ro)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inatrace_unocace_stage
DB_USER=inatrace_mcp_ro
DB_PASSWORD=your_secure_ro_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10

# Spring Boot Core API (CQRS Write Delegation)
CORE_API_URL=http://localhost:8080/api

# Keycloak OIDC Authentication
KEYCLOAK_URL=https://auth.unocace.com
KEYCLOAK_REALM=unocace
SERVICE_ACCOUNT_CLIENT_ID=service-account-erp-contable
SERVICE_ACCOUNT_CLIENT_SECRET=your_client_secret_here
