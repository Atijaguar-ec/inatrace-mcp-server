# INATrace MCP Server Environment Configuration Template

# Server Configuration
SERVER_NAME=inatrace-oracle
PORT=8000
DEBUG=false

# PostgreSQL Database (Read-Only User inatrace_mcp_ro)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inatrace_unocace_stage
DB_USER=inatrace_mcp_ro
DB_PASSWORD=your_secure_ro_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10

# Spring Boot Core API (CQRS Write Delegation)
CORE_API_URL=http://localhost:8080/api

# Keycloak OIDC Authentication
# Base del realm. Debe coincidir con el issuer que emite Keycloak, o fijar
# KEYCLOAK_ISSUER / KEYCLOAK_JWKS_URL por separado. El valor anterior
# (auth.unocace.com) apunta a un host cuyo certificado TLS no es válido.
KEYCLOAK_URL=https://inatrace.test.unocace.com/auth
KEYCLOAK_REALM=unocace
SERVICE_ACCOUNT_CLIENT_ID=service-account-erp-contable
SERVICE_ACCOUNT_CLIENT_SECRET=your_client_secret_here

# RS256 signature verification against the realm JWKS.
# KEYCLOAK_AUDIENCE accepts a comma-separated list and must match the 'aud' claim
# Keycloak issues for this server (configure an audience mapper on the client).
# Leaving it empty rejects every token: the server fails closed, it does not relax
# verification.
KEYCLOAK_AUDIENCE=inatrace-mcp

# The issuer that signs the tokens and the URL this server fetches the JWKS from do
# not always match: behind a reverse proxy, Keycloak issues 'iss' with its public URL
# while this server only reaches it on the internal network. Leave both empty to
# derive them from KEYCLOAK_URL. Take the exact values from the realm's
# .well-known/openid-configuration (fields "issuer" and "jwks_uri").
KEYCLOAK_ISSUER=
KEYCLOAK_JWKS_URL=

KEYCLOAK_JWKS_TTL_SECONDS=600
KEYCLOAK_JWKS_MIN_REFRESH_SECONDS=30
KEYCLOAK_JWKS_TIMEOUT_SECONDS=5.0

# Transporte HTTP (Starlette / Uvicorn)
# MAX_REQUEST_BYTES acota la memoria que puede consumir una sola petición: los
# cuerpos JSON-RPC legítimos de este servidor son de pocos kilobytes.
MAX_REQUEST_BYTES=1048576
BODY_READ_TIMEOUT_SECONDS=15.0
TOOL_TIMEOUT_SECONDS=30.0
KEEP_ALIVE_TIMEOUT_SECONDS=5
